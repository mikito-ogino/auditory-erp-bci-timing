[Unit]
Description=Auditory BCI acquisition server (headless, browser-controlled)
Documentation=file:/home/pi/AuditoryBCI/README.md
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/AuditoryBCI
# USB enumeration (Cyton dongle, USB audio) is not finished the instant the
# network comes up; give the kernel a moment before probing for them.
ExecStartPre=/bin/sleep 8
ExecStart=/usr/bin/python3 /home/pi/AuditoryBCI/bci_server.py
Restart=on-failure
RestartSec=10
# Line-buffer stdout so the journal shows progress instead of a stale block
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
